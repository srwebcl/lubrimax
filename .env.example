# ─────────────────────────────────────────────────────────────
# LUBRIMAX — variables de entorno
# Copia a .env (local) y configúralas también en Vercel.
# ─────────────────────────────────────────────────────────────

# Base de datos (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"   # sin pooler, para prisma db push / migrate

# ── Panel de personal (admin + trabajadores) ──
# Firma de la cookie de sesión del panel. OBLIGATORIA.
# Generar con:  openssl rand -base64 32
STAFF_SESSION_SECRET=""

# Solo para el bootstrap del primer administrador (scripts/seed-staff-admin.ts).
# Tras crear el primer admin desde el panel puedes borrar estas dos.
SEED_ADMIN_EMAIL="dueno@lubrimax.cl"
SEED_ADMIN_PASSWORD="cambia-esto-por-algo-largo"
SEED_ADMIN_NAME="Nombre Apellido"

# ── Sesión de clientes (tienda / club) ──
CUSTOMER_SESSION_SECRET=""

# ── Cloudflare R2 (imágenes de catálogo/tienda) ──
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
NEXT_PUBLIC_R2_DEV_URL=""

# ── Email transaccional (Resend) ──
RESEND_API_KEY=""
OWNER_EMAIL=""

# ── Sitio ──
NEXT_PUBLIC_SITE_URL="https://lubrimax.cl"

# ── OBSOLETO ──
# ADMIN_USER / ADMIN_PASSWORD ya NO se usan en el login del panel (ahora es
# por correo contra la tabla StaffUser). Solo sirven como fallback del script
# de seed si no defines las SEED_ADMIN_*.
