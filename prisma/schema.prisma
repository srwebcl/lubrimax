generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int       // Duración en minutos (ej: 60, 360)
  priceAuto   Int?
  priceSuv2   Int?
  priceSuv3   Int?
  category    String    @default("Detailing") // Mantener temporalmente para evitar que se rompa la DB al migrar
  categoryId  String?
  serviceCategory ServiceCategory? @relation(fields: [categoryId], references: [id])
  badges      String[]  @default([])
  variants    Json?     // Ej: [{ name: "Opción 1", priceAuto: 1000, duration: 30 }]
  image       String?   // Imagen miniatura específica del servicio (Mantenido por retrocompatibilidad)
  images      String[]  @default([]) // Galería de imágenes del servicio
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique // Ej: "Lavados", "Detailing"
  slug        String    @unique
  description String?
  image       String?
  color       String?   // Degradado de la tarjeta. Ej: "from-blue-500 to-brand-cyan"
  isActive    Boolean   @default(true)
  
  services    Service[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  date          DateTime // Fecha específica de la reserva (sin hora, a las 00:00:00)
  startTime     String   // Formato "HH:mm" (ej: "14:00")
  endTime       String   // Formato "HH:mm" (ej: "20:00")
  status        String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  // Estado operativo del trabajo en taller. Campo SEPARADO de `status` a
  // propósito: `status` es el ciclo comercial/administrativo de la reserva
  // (lo maneja el admin), `workStatus` es el avance físico del trabajo que
  // marca el trabajador desde la PWA. PENDING = por hacer, IN_PROGRESS = en
  // proceso, DONE = terminado.
  workStatus    String   @default("PENDING")
  paymentStatus String   @default("PENDING") // PENDING, PAID_RESERVATION, PAID_FULL
  paymentType   String?  // RESERVATION o FULL: lo que el cliente eligió pagar en Webpay
  paymentId     String?  // Token de la transacción Webpay
  amount        Int?     // Monto efectivamente cobrado (calculado en servidor, nunca confiar en el cliente)
  customerName  String
  customerPhone String
  customerEmail String?
  vehicleMake   String
  vehicleModel  String
  
  services      Service[]
  selectedOptions Json?    // Almacena la variante elegida por servicio. Ej: { "serviceId": "Opción 1" }

  intakes       VehicleIntake[] // Ingresos de vehículo asociados a esta reserva

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// MÓDULO: RECEPCIÓN DE VEHÍCULOS (lo usa el TRABAJADOR)
// ==========================================
// Clientes/vehículos que atiende el taller, identificados por PATENTE. Es
// independiente del modelo `Customer` (cuentas de la tienda/Club con
// contraseña). Acá el registro lo hace el trabajador cuando llega un auto,
// con o sin reserva previa.

model WorkshopClient {
  id        String    @id @default(cuid())
  name      String
  rut       String?   @unique // Normalizado sin puntos, con guion. Único si viene.
  phone     String?
  email     String?

  vehicles  Vehicle[]

  createdByStaffId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vehicle {
  id        String   @id @default(cuid())
  plate     String   @unique // Normalizada: MAYÚSCULAS, sin espacios ni guiones
  make      String
  model     String
  color     String?

  clientId  String
  client    WorkshopClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  intakes   VehicleIntake[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model VehicleIntake {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Opcional: si el ingreso corresponde a una reserva de la agenda.
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  photoUrl   String?  // Foto del vehículo / patente al ingresar (R2)
  odometer   Int?     // Kilometraje declarado
  notes      String?  // Observaciones de recepción (rayones, detalles, etc.)
  status     String   @default("IN_SHOP") // IN_SHOP = en taller, DELIVERED = entregado

  createdByStaffId   String?
  createdByStaffName String? // Copia denormalizada para la bitácora
  deliveredAt        DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// MÓDULO: PERSONAL / ACCESOS AL PANEL (PWA)
// ==========================================

enum StaffRole {
  ADMIN  // Acceso total al panel
  WORKER // Solo la Agenda operativa (marcar avance de trabajos)
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String    // Hash bcrypt
  name         String
  role         StaffRole @default(WORKER)
  isActive     Boolean   @default(true)
  // Se incrementa para invalidar de inmediato todas las sesiones abiertas de
  // este usuario (cambio de contraseña, "forzar cierre de sesión",
  // desactivación). El token de sesión lleva este número y se compara contra
  // la BD en cada request sensible.
  sessionEpoch Int       @default(0)
  lastLoginAt  DateTime?

  activity     BookingActivityLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Bitácora de acciones del personal sobre las reservas (quién marcó qué y
// cuándo). Sirve para auditoría y para resolver disputas operativas.
model BookingActivityLog {
  id          String    @id @default(cuid())
  bookingId   String
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  staffName   String    // Copia denormalizada: el log sobrevive aunque se borre el usuario
  action      String    // Ej: "WORK_STATUS", "STATUS", "RESCHEDULE"
  detail      String?   // Ej: "PENDING -> IN_PROGRESS"
  createdAt   DateTime  @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model Settings {
  id             String   @id @default("global")
  workStartHour  Int      @default(9)
  workEndHour    Int      @default(18)
  concurrentBays      Int      @default(1)
  slotInterval        Int      @default(30)
  advanceBookingHours Int      @default(12)
  homeVideos          String[] @default([])
  storeBanners        String[] @default([])
  storeBanner         String?
  updatedAt           DateTime @updatedAt
}

// ==========================================
// MÓDULO: CLIENTES Y CLUB LUBRIMAX
// ==========================================

model Customer {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String    // Hashed
  name           String
  rut            String?   @unique
  phone          String?
  
  // Membresía
  membershipId   String?
  membership     MembershipTier? @relation(fields: [membershipId], references: [id])
  membershipSince DateTime?
  membershipUntil DateTime?
  
  orders         Order[]
  reviews        Review[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MembershipTier {
  id              String    @id @default(cuid())
  name            String    // Ej: "Titanium"
  price           Int       // Precio mensual o anual
  discountPercent Int       // Ej: 15 (15% de descuento en servicios)
  features        String[]  // Array de beneficios
  isActive        Boolean   @default(true)
  
  customers       Customer[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Partner {
  id          String    @id @default(cuid())
  name        String
  logo        String?
  description String?
  benefits    String[]
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// MÓDULO: TIENDA EN LÍNEA (E-COMMERCE)
// ==========================================

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  isActive    Boolean   @default(true)
  
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Int       // Precio base (desde)
  stock       Int       @default(0) // Stock general o total
  
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  
  image       String?   // Imagen principal (Thumbnail)
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  
  isActive    Boolean   @default(true)
  
  orderItems  OrderItem[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id          String   @id @default(cuid())
  name        String   // Ej: "500ml", "1 Litro", "Olor Vainilla"
  price       Int?     // Precio específico de esta variante (sobrescribe el base si existe)
  stock       Int      @default(0)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1 a 5
  comment     String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isApproved  Boolean  @default(true) // Admin puede ocultar reseñas abusivas
  createdAt   DateTime @default(now())
}

model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique // Ej: CYBER2026
  discountPct Int      // Porcentaje (Ej: 15 para 15%)
  isActive    Boolean  @default(true)
  validUntil  DateTime?
  usageLimit  Int?     // Veces que se puede usar en total
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Order {
  id            String    @id @default(cuid())
  total         Int
  status        String    @default("PENDING") // PENDING, PAID, FAILED, SHIPPED, DELIVERED
  paymentId     String?   // Transbank Token
  discountCode  String?   // Si aplicó algún cupón
  discountTotal Int       @default(0) // Cuánto dinero ahorró
  
  // Datos de Envío
  shippingType  String    @default("PICKUP") // DELIVERY o PICKUP
  address       String?
  city          String?
  trackingCode  String?
  notes         String?
  
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  
  items         OrderItem[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Int     // Precio al momento de la compra
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
}
